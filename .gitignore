__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# generated example figures / run outputs (scratch)
*.png
*.npz
figs/*
!figs/.gitkeep
results/*
!results/.gitkeep

# ...but DO track the curated paper figures, so the paper compiles from a clone
!docs/paper/figs/
!docs/paper/figs/*.png

# LaTeX build artifacts (keep the .tex source and figures)
*.aux
*.log
*.out
*.synctex.gz
docs/paper/*.pdf

# large reference PDFs (kept locally under docs/literature, not tracked)
docs/literature/*.pdf
